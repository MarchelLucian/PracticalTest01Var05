<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ===== NAVIGATE ===== -->
    <Button
        android:id="@+id/navigate_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Navigate to secondary activity" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/compass_top_half"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/top_left_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top Left" />


                <Space
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/top_right_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top right" />
            </LinearLayout>

            <Button
                android:id="@+id/center_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:text="Center" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">

                <Button
                    android:id="@+id/bottom_left_button"
                    android:layout_width="0dp"

                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bottom left" />


                <Space
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"/>


                <Button
                    android:id="@+id/bottom_right_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bottom right" />
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/compass_bottom_half"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compass_directions_text"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center"
                android:saveEnabled="false"
                android:text="" />

            <TextView
                android:id="@+id/compass_clicks_text"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center"
                android:saveEnabled="false"
                android:text="" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
